# Configuração de ambiente do InsurMind Chatbot.
# Copie este arquivo pra `.env` (na raiz do projeto) e preencha os valores.
# .env está no .gitignore — nunca vai pro repositório.

# === Escolha do provider de LLM ===
# Opções:
#   anthropic_api  - Anthropic API HTTPS direta (recomendado pra dev e produção)
#   claude_code    - Claude Code CLI local (gratuito se você tem Claude Code instalado e logado)
#   gemini         - Google Gemini API (free tier generoso, alternativa pra economizar tokens)
INSURMIND_LLM=anthropic_api

# === Anthropic API ===
# Obtenha em https://console.anthropic.com/settings/keys
# Necessária se INSURMIND_LLM=anthropic_api. Formato: sk-ant-api03-...
ANTHROPIC_API_KEY=

# Opcional: sobrescreve o modelo Anthropic default (claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# === Gemini API (alternativa free) ===
# Obtenha em https://aistudio.google.com/apikey
# Free tier: 15 req/min, 1500 req/dia.
# Necessário se INSURMIND_LLM=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# === Logging interno (opcional) ===
# Default INFO. Use DEBUG pra ver embeddings dims, ChromaDB queries detalhadas etc.
# INSURMIND_LOG_LEVEL=INFO

# === CORS pra deploy (opcional em dev local) ===
# Em produção, sempre setar pra URL do frontend Vercel.
# Em dev local, o default já permite localhost:3000/3001.
# INSURMIND_CORS_ORIGINS=https://insurminds-chatbot.vercel.app

# === Modelo de embedding (opcional) ===
# Default: intfloat/multilingual-e5-base (em fp16 — ~236MB de RAM).
# Trocar pra e5-small se rodar em ambiente com pouca RAM (HF Spaces free tem 16GB, sobra; já estava setado pra small em produção quando o caminho era Render 512MB).
# INSURMIND_EMBED_MODEL=intfloat/multilingual-e5-base

# === Força fp32 do modelo de embedding (opcional) ===
# Default: fp16 (cabe em 512MB de RAM se for caso necessário).
# Setar como "1" pra forçar fp32 (qualidade ligeiramente melhor, ~2x mais RAM).
# Útil quando tiver GPU com VRAM suficiente.
# INSURMIND_FP32=1
