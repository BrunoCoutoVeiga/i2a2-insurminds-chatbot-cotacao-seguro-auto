# Copie este arquivo para .env e preencha conforme o provider de LLM escolhido.
# A escolha é feita via env var INSURMIND_LLM (default: claude_code).

# --- Default: Claude Code SDK (local, gratuito durante dev) ---
# Em desenvolvimento local, o claude-agent-sdk usa a sessão do Claude Code CLI
# se você estiver logado. Caso contrário, defina ANTHROPIC_API_KEY abaixo.
INSURMIND_LLM=claude_code
ANTHROPIC_API_KEY=

# --- Gemini (pré-requisito do Modo Debug da UI Streamlit) ---
# Obtenha API key gratuita em https://aistudio.google.com/apikey
# Free tier do gemini-2.5-flash: 15 req/min, 1500 req/dia — suficiente pra demo.
# Para usar: INSURMIND_LLM=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
