# Variáveis de ambiente do frontend Next.js.
#
# Em dev local: copie este arquivo para `.env.local` (ignorado pelo git) e
# ajuste se o backend estiver em outra URL/porta.
#
# Em prod (Vercel): configure essas variáveis no dashboard do Vercel em
# Project Settings → Environment Variables. Variáveis com prefixo
# NEXT_PUBLIC_ ficam embutidas no bundle do client — não use pra secrets.

# URL do backend FastAPI. Default em dev: http://127.0.0.1:8000
# Em prod: https://insurmind-api-xxx.onrender.com (URL do Render)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
